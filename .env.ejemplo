# Copiar este archivo a .env y completar con tus propios valores.
# Nunca versionar el .env real (ya esta en .gitignore).

# Free tier de la API de Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Credenciales de la base local (docker-compose.yml). No son secretos reales:
# la base solo corre en localhost para desarrollo, con datos sinteticos.
POSTGRES_USER=agente_voz
POSTGRES_PASSWORD=agente_voz
POSTGRES_DB=agente_voz
